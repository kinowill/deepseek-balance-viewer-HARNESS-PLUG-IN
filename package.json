{
  "name": "dsh-balance-viewer",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: live DeepSeek platform balance badge in the sidebar (API key stored in the DSH credentials store)",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "package.json"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "balance"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinowill/deepseek-balance-viewer-HARNESS-PLUG-IN.git"
  },
  "license": "MIT"
}
